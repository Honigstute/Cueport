#!/usr/bin/env bash
set -euo pipefail

backup_root=/var/backups/cueport
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
destination="$backup_root/$timestamp"

install -d -m 0700 -o postgres -g postgres "$destination"
runuser -u postgres -- pg_dump --format=custom --file="$destination/database.dump" cueport
chown root:root "$destination" "$destination/database.dump"

# Published assets are immutable. Snapshot them as hard links instead of
# writing another full compressed archive on every deployment. Removing a live
# revision or an old backup only removes that name; the remaining hard link
# keeps the recovery copy intact without duplicating file data on disk.
install -d -m 0700 "$destination/assets"
rsync --archive --hard-links \
  --exclude='*.uploading' \
  --exclude='*.reusing' \
  --link-dest=/var/lib/cueport/assets/ \
  /var/lib/cueport/assets/ "$destination/assets/"

# Keep per-file integrity data without wrapping the snapshot in a second copy.
(
  cd "$destination/assets"
  find . -type f -print0 | sort -z | xargs -0 -r sha256sum
) > "$destination/ASSET_SHA256SUMS"
sha256sum "$destination/database.dump" "$destination/ASSET_SHA256SUMS" > "$destination/SHA256SUMS"
chmod 0600 "$destination/database.dump" "$destination/ASSET_SHA256SUMS" "$destination/SHA256SUMS"

# Keep two weeks of daily recovery points. The preflight portfolio backup is
# stored elsewhere and is never touched by this cleanup.
find "$backup_root" -mindepth 1 -maxdepth 1 -type d -mtime +14 -exec rm -rf -- {} +
